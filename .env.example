# ---------------------------------------------------------------------------
# Stash environment variables. Copy to .env.local for local development.
# Values marked [secret] must never be exposed to the browser: only variables
# prefixed with NEXT_PUBLIC_ end up in client bundles.
# ---------------------------------------------------------------------------

# Supabase project (Settings > API). Locally: printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Publishable / anon key (safe in the browser, RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [secret] Service role / secret key: server routes, cron, seed scripts only
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for auth redirects and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=you@example.com

# [secret] Anthropic API key (content generation, server side only)
ANTHROPIC_API_KEY=
# Model used by the pipeline
ANTHROPIC_MODEL=claude-opus-5-5
# "default" = server-side refusal fallback (recommended); "off" for models that don't support it
ANTHROPIC_FALLBACKS=default

# Optional: Google Books API key (works without one, with a lower quota)
GOOGLE_BOOKS_API_KEY=

# [secret] Shared secret between the pipeline and the `embed` Edge Function.
# Set the same value on Supabase: npx supabase secrets set EMBEDDING_FUNCTION_SECRET=...
EMBEDDING_FUNCTION_SECRET=
# Optional override (defaults to $NEXT_PUBLIC_SUPABASE_URL/functions/v1/embed)
EMBEDDING_FUNCTION_URL=

# Optional: local fast voice server (Kokoro). Start it with `npm run tts:kokoro`
# (setup once: `npm run tts:kokoro:setup`). When reachable, its voices are offered and used by default.
KOKORO_URL=

# [secret] Protects /api/cron/ingest. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# Daily pipeline limits (cost cap)
INGEST_MAX_MODEL_CALLS=60
INGEST_MAX_BOOKS_PER_RUN=8
INGEST_QUERIES_PER_RUN=6
INGEST_TIME_BUDGET_SECONDS=270
# auto = publish cards that pass every check; review = keep them as drafts for /admin
INGEST_PUBLISH_MODE=auto
INGEST_USER_AGENT=StashApp/1.0 (microlearning; contact via site)

# Initial seed (npm run seed)
SEED_CARDS_PER_CATEGORY=100
SEED_BOOKS_PER_CATEGORY=60
SEED_MAX_MODEL_CALLS=1500
